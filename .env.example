# OPTIONAL: All local demo modules work without environment variables.
# Future authenticated server adapter only. Never set privileged service-role keys.
# Copy to .env.local only when you intentionally configure your Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional live Groq selection, all server-side. Never use NEXT_PUBLIC_ here.
# Choose a currently supported JSON-object model from Groq's official console.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_LIVE_ENABLED=false
# Durable shared request budget is required before enabling public live calls.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Defaults: 6/minute and 100/UTC day, shared by all visitors.
GROQ_REQUESTS_PER_MINUTE=6
GROQ_REQUESTS_PER_DAY=100
